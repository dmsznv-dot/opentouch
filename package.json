{
  "name": "opentouch",
  "productName": "OpenTouch",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight projection mapping for macOS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:render": "playwright test --project=render",
    "test:e2e": "electron-vite build && playwright test --project=e2e",
    "test": "npm run typecheck && npm run test:unit && npm run test:render"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
